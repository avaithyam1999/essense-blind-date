{
  "expo": {
    "name": "Essense",
    "slug": "blind-date-app",
    "scheme": "essense",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F7F3ED",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.blinddate.app"
    },
    "android": {
      "package": "com.blinddate.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F3ED"
      }
    },
    "plugins": ["expo-router"]
  }
}
