# ---------------------------------------------------------------------------
# App (Expo) -- these are PUBLIC. Anything prefixed EXPO_PUBLIC_ is inlined
# into the JS bundle at build time and shipped to every browser/device.
# Set both locally in .env AND in Vercel (Project -> Settings -> Environment
# Variables) for Production and Preview. Changing them requires a redeploy.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Server-only -- NEVER set these in Vercel or prefix them with EXPO_PUBLIC_.
# Listed here for reference only.
# ---------------------------------------------------------------------------
# Used by scripts/seed.js when you run it locally:
#   SUPABASE_URL=https://your-project-ref.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Used by the daily-question Edge Function. Set with
# `supabase secrets set ANTHROPIC_API_KEY=...` (SUPABASE_URL, SUPABASE_ANON_KEY
# and SUPABASE_SERVICE_ROLE_KEY are provided to Edge Functions automatically):
#   ANTHROPIC_API_KEY=sk-ant-...
